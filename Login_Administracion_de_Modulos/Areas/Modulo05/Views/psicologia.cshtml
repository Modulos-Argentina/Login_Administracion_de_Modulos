@*
    Módulo 05: Psicología - Bienestar Estudiantil
    Vista del Formulario de Atención y Consulta Psicológica
    ASP.NET Core Razor (.NET 10)
*@
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Psicología - ISTP Argentina</title>
</head>
<body>

    <!-- Encabezado / Barra Superior -->
    <header>
        <div>
            <h1>ISTP ARGENTINA.</h1>
            <span>Psicología</span>
        </div>
        <div>
            <span>PostgreSQL: Online</span>
            <div>
                <span>Lic. Andrea (Psicología)</span>
                <small>PSICOLOGIA</small>
            </div>
            <button type="button" title="Cerrar sesión">Salir</button>
        </div>
    </header>

    <!-- Contenido Principal: Formulario de Psicología -->
    <main>
        <form method="post" action="">

            <!-- I. IDENTIFICACIÓN DEL ESTUDIANTE -->
            <fieldset>
                <legend>I. IDENTIFICACIÓN DEL ESTUDIANTE</legend>

                <div>
                    <label for="dniBusqueda">BUSCAR ALUMNO (DNI)</label>
                    <input type="text" id="dniBusqueda" name="dniBusqueda" placeholder="DNI..." maxlength="8" />
                    <button type="button" id="btnBuscarAlumno">Buscar</button>
                </div>

                <div>
                    <label for="apellidosNombres">APELLIDOS Y NOMBRES</label>
                    <input type="text" id="apellidosNombres" name="apellidosNombres" placeholder="- - -" readonly />
                </div>

                <div>
                    <label for="carreraPrograma">CARRERA / PROGRAMA</label>
                    <input type="text" id="carreraPrograma" name="carreraPrograma" placeholder="- - -" readonly />
                </div>

                <div>
                    <label for="cicloTurno">CICLO / TURNO</label>
                    <input type="text" id="cicloTurno" name="cicloTurno" placeholder="- - -" readonly />
                </div>
            </fieldset>

            <!-- II. CREACIÓN DE EXPEDIENTE / CONSULTA ACTUAL -->
            <fieldset>
                <legend>II. CREACIÓN DE EXPEDIENTE / CONSULTA ACTUAL</legend>

                <div>
                    <label for="fechaHora">FECHA Y HORA</label>
                    <input type="datetime-local" id="fechaHora" name="fechaHora" value="2026-09-26T19:30" />
                </div>

                <div>
                    <label for="estadoClinico">ESTADO CLÍNICO *</label>
                    <select id="estadoClinico" name="estadoClinico" required>
                        <option value="Pendiente — Evaluación Inicial" selected>Pendiente — Evaluación Inicial</option>
                        <option value="En Proceso — En Terapia / Seguimiento">En Proceso — En Terapia / Seguimiento</option>
                        <option value="Derivado — Especialista Externo">Derivado — Especialista Externo</option>
                        <option value="Alta — Tratamiento Concluido">Alta — Tratamiento Concluido</option>
                        <option value="Cancelado / Inasistencia">Cancelado / Inasistencia</option>
                    </select>
                </div>

                <div>
                    <label for="motivoConsulta">MOTIVO DE CONSULTA Y CONTEXTO ACADÉMICO / FAMILIAR</label>
                    <textarea id="motivoConsulta" name="motivoConsulta" rows="4" cols="50" placeholder="Síntomas referidos o razones de bajo rendimiento..."></textarea>
                </div>
            </fieldset>

            <!-- DIAGNÓSTICO PRELIMINAR Y NOTAS CONFIDENCIALES DE TERAPIA -->
            <fieldset>
                <legend>DIAGNÓSTICO PRELIMINAR Y NOTAS CONFIDENCIALES DE TERAPIA</legend>

                <div>
                    <p><strong>NOTAS BAJO SECRETO PROFESIONAL</strong></p>
                    <label for="diagnosticoNotas">Notas de Terapia:</label>
                    <textarea id="diagnosticoNotas" name="diagnosticoNotas" rows="6" cols="50" placeholder="Evaluación HTP, Test Vocacional, Notas bajo secreto profesional..."></textarea>
                </div>
            </fieldset>

            <!-- Botones de Acción -->
            <div>
                <button type="reset" id="btnLimpiar">Limpiar</button>
                <button type="submit" id="btnGuardar">Guardar Sesión</button>
            </div>

        </form>
    </main>

</body>
</html>
