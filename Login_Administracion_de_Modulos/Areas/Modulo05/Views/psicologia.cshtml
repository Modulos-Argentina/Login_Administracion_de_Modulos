@{
    // Si la petición NO es parcial, usar el layout del dashboard
    if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest" && Context.Request.Query["partial"] != "true")
    {
        Layout = "~/Vista/Shared/_DashboardLayout.cshtml";
    }
    ViewData["Title"] = "Psicología";
    ViewData["Role"] = "Bienestar Estudiantil";
}

@section SidebarNav {
    <a href="javascript:void(0)" class="nav-item active" id="nav-atencion" onclick="mostrarAtencionPsicologia()">
        <i class="ph ph-brain"></i>
        <span>Atención Psicológica</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-agenda" onclick="alert('Módulo de Citas y Agenda Programada');">
        <i class="ph ph-calendar-check"></i>
        <span>Citas Programadas</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-historial" onclick="mostrarHistorialPsicologia()">
        <i class="ph ph-file-text"></i>
        <span>Historial Clínico</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-pacientes" onclick="mostrarHistorialPsicologia()">
        <i class="ph ph-users"></i>
        <span>Padrón de Pacientes</span>
    </a>
}

<style>
    /* Premium Aesthetic CSS for Psychology Module */
    :root {
        --primary-psy: #6366f1; /* Indigo */
        --secondary-psy: #a855f7; /* Purple */
        --dark-card: #1e1e2d;
        --dark-bg: #151521;
        --border-glass: rgba(255, 255, 255, 0.1);
        --text-muted: #9ca3af;
        --text-bright: #f3f4f6;
    }

    body {
        background-color: var(--dark-bg);
        color: var(--text-bright);
        font-family: 'Inter', system-ui, sans-serif;
    }

    .psy-header {
        margin-bottom: 2rem;
        position: relative;
    }

    .psy-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(90deg, var(--primary-psy), var(--secondary-psy));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .psy-header p {
        color: var(--text-muted);
        font-size: 1rem;
    }

    .psy-form-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .psy-fieldset {
        background: rgba(30, 30, 45, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .psy-fieldset:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
        border-color: rgba(99, 102, 241, 0.3);
    }

    .psy-legend {
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(90deg, var(--primary-psy), var(--secondary-psy));
        padding: 0.4rem 1.2rem;
        border-radius: 8px;
        display: inline-block;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }

    .psy-form-group {
        margin-bottom: 1.2rem;
        position: relative;
    }

    .psy-label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #e5e7eb;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    .psy-input, .psy-select, .psy-textarea {
        width: 100%;
        background: rgba(15, 15, 20, 0.8);
        border: 1px solid var(--border-glass);
        color: #fff;
        padding: 0.8rem 1rem;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .psy-input:focus, .psy-select:focus, .psy-textarea:focus {
        outline: none;
        border-color: var(--primary-psy);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }

    .psy-input::placeholder, .psy-textarea::placeholder {
        color: #6b7280;
    }

    .psy-input[readonly] {
        background: rgba(255, 255, 255, 0.03);
        color: #9ca3af;
        cursor: not-allowed;
    }

    .psy-btn-search {
        background: linear-gradient(135deg, var(--primary-psy), #4f46e5);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }

    .psy-btn-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.5);
    }

    .psy-btn-search:active {
        transform: translateY(0);
    }

    .psy-btn-save {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        border: none;
        padding: 0.9rem 2rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .psy-btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }

    .psy-btn-reset {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 1px solid var(--border-glass);
        padding: 0.9rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .psy-btn-reset:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .psy-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
        justify-content: flex-end;
    }

    .psy-search-group {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .psy-status-msg {
        font-size: 0.9rem;
        font-weight: 500;
        margin-top: 0.5rem;
    }

    .psy-warning {
        color: #fca5a5;
        background: rgba(239, 68, 68, 0.1);
        padding: 0.5rem 1rem;
        border-left: 4px solid #ef4444;
        border-radius: 4px;
        margin-bottom: 1rem;
        font-weight: 500;
    }
</style>

<div id="view-atencion">
    <div class="psy-header">
        <h1>Módulo 05: Psicología</h1>
        <p>Formulario Dinámico de Atención y Consulta Psicológica</p>
    </div>

    <form id="formPsicologia" onsubmit="event.preventDefault(); guardarAtencionPsicologica();" class="psy-form-container">

        <!-- I. IDENTIFICACIÓN DEL ESTUDIANTE -->
        <div class="psy-fieldset">
            <div class="psy-legend"><i class="ph-bold ph-identification-card"></i> I. IDENTIFICACIÓN DEL ESTUDIANTE</div>

            <div class="psy-form-group">
                <label for="dniBusqueda" class="psy-label">BUSCAR ALUMNO (DNI):</label>
                <div class="psy-search-group">
                    <input type="text" id="dniBusqueda" name="dniBusqueda" class="psy-input" placeholder="Ingrese DNI..." maxlength="20" style="max-width: 300px;" />
                    <button type="button" id="btnBuscarAlumno" class="psy-btn-search" onclick="buscarPacienteDni()">
                        <i class="ph-bold ph-magnifying-glass"></i> Buscar
                    </button>
                    <span id="dniStatus" class="psy-status-msg"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                <div class="psy-form-group">
                    <label for="apellidosNombres" class="psy-label">APELLIDOS Y NOMBRES</label>
                    <input type="text" id="apellidosNombres" name="apellidosNombres" class="psy-input" placeholder="- - -" readonly />
                </div>

                <div class="psy-form-group">
                    <label for="carreraPrograma" class="psy-label">CARRERA / PROGRAMA</label>
                    <input type="text" id="carreraPrograma" name="carreraPrograma" class="psy-input" placeholder="- - -" readonly />
                </div>

                <div class="psy-form-group">
                    <label for="cicloTurno" class="psy-label">CICLO / TURNO</label>
                    <input type="text" id="cicloTurno" name="cicloTurno" class="psy-input" placeholder="- - -" readonly />
                </div>
            </div>
        </div>

        <!-- II. CREACIÓN DE EXPEDIENTE / CONSULTA ACTUAL -->
        <div class="psy-fieldset">
            <div class="psy-legend"><i class="ph-bold ph-folder-open"></i> II. CREACIÓN DE EXPEDIENTE / CONSULTA ACTUAL</div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                <div class="psy-form-group">
                    <label for="fechaHora" class="psy-label">FECHA Y HORA</label>
                    <input type="datetime-local" id="fechaHora" name="fechaHora" class="psy-input" />
                </div>

                <div class="psy-form-group">
                    <label for="estadoClinico" class="psy-label">ESTADO CLÍNICO *</label>
                    <select id="estadoClinico" name="estadoClinico" class="psy-select" required>
                        <option value="Pendiente" selected>Pendiente — Evaluación Inicial</option>
                        <option value="En Proceso">En Proceso — En Terapia / Seguimiento</option>
                        <option value="Derivado">Derivado — Especialista Externo</option>
                        <option value="Alta">Alta — Tratamiento Concluido</option>
                        <option value="Cancelado">Cancelado / Inasistencia</option>
                    </select>
                </div>
            </div>

            <div class="psy-form-group">
                <label for="motivoConsulta" class="psy-label">MOTIVO DE CONSULTA Y CONTEXTO ACADÉMICO / FAMILIAR *</label>
                <textarea id="motivoConsulta" name="motivoConsulta" class="psy-textarea" rows="3" required placeholder="Síntomas referidos o razones de bajo rendimiento..."></textarea>
            </div>
        </div>

        <!-- DIAGNÓSTICO PRELIMINAR Y NOTAS CONFIDENCIALES DE TERAPIA -->
        <div class="psy-fieldset">
            <div class="psy-legend"><i class="ph-bold ph-lock-key"></i> III. NOTAS CLÍNICAS</div>

            <div class="psy-form-group">
                <div class="psy-warning">
                    <i class="ph-fill ph-warning-circle"></i> NOTAS BAJO SECRETO PROFESIONAL
                </div>
                <label for="diagnosticoNotas" class="psy-label">Notas de Terapia / Diagnóstico Preliminar:</label>
                <textarea id="diagnosticoNotas" name="diagnosticoNotas" class="psy-textarea" rows="4" placeholder="Evaluación HTP, Test Vocacional, Notas confidenciales..."></textarea>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="psy-actions">
            <span id="resultadoAtencion" class="psy-status-msg" style="margin-right: auto; display: flex; align-items: center;"></span>
            <button type="reset" id="btnLimpiar" class="psy-btn-reset" onclick="limpiarFormulario()">
                <i class="ph-bold ph-arrow-counter-clockwise"></i> Limpiar
            </button>
            <button type="submit" id="btnGuardar" class="psy-btn-save">
                <i class="ph-bold ph-floppy-disk"></i> Guardar Sesión
            </button>
        </div>

    </form>
</div>

<div id="view-historial" style="display: none;">
    <div class="psy-header">
        <h1>Historial Clínico Psicológico</h1>
        <p>Consulta de expedientes y registros anteriores de atención</p>
    </div>
    
    <div class="psy-fieldset">
        <div style="margin-bottom: 2rem;">
            <label for="dniHistorial" class="psy-label">BUSCAR HISTORIAL POR DNI:</label>
            <div class="psy-search-group">
                <input type="text" id="dniHistorial" name="dniHistorial" class="psy-input" placeholder="Ingrese DNI..." maxlength="20" style="max-width: 300px;" />
                <button type="button" onclick="cargarHistorialPsicologia()" class="psy-btn-search">
                    <i class="ph-bold ph-magnifying-glass"></i> Buscar Historial
                </button>
                <span id="historialStatus" class="psy-status-msg"></span>
            </div>
        </div>

        <div id="historialResultados" style="display: none;">
            <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: #fff;">Sesiones Previas</h3>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; color: #f3f4f6;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted);">
                            <th style="padding: 12px 10px;">Fecha y Hora</th>
                            <th style="padding: 12px 10px;">Motivo de Consulta</th>
                            <th style="padding: 12px 10px;">Estado</th>
                            <th style="padding: 12px 10px;">Notas Clínicas</th>
                        </tr>
                    </thead>
                    <tbody id="historialTableBody">
                        <!-- Filas dinámicas -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Inicializar fecha
    (function initFechaHora() {
        const inputFecha = document.getElementById('fechaHora');
        if (inputFecha && !inputFecha.value) {
            const now = new Date();
            const tzOffset = now.getTimezoneOffset() * 60000;
            inputFecha.value = (new Date(now - tzOffset)).toISOString().slice(0, 16);
        }
    })();

    function buscarPacienteDni() {
        const dniInput = document.getElementById('dniBusqueda');
        const statusSpan = document.getElementById('dniStatus');
        const dni = dniInput ? dniInput.value.trim() : '';

        if (!dni) {
            alert('Por favor ingrese el número de DNI a buscar.');
            if (dniInput) dniInput.focus();
            return;
        }

        if (statusSpan) {
            statusSpan.style.color = 'var(--text-muted)';
            statusSpan.innerHTML = '<i class="ph ph-spinner ph-spin"></i> Buscando...';
        }

        fetch('/Modulo05/Psicologia/BuscarPaciente?dni=' + encodeURIComponent(dni))
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (statusSpan) {
                        statusSpan.style.color = '#10b981';
                        statusSpan.innerHTML = '<i class="ph-bold ph-check-circle"></i> Encontrado';
                    }
                    const nomInput = document.getElementById('apellidosNombres');
                    const carInput = document.getElementById('carreraPrograma');
                    const cicInput = document.getElementById('cicloTurno');

                    if (nomInput) nomInput.value = (data.apellidos + ' ' + data.nombres).trim();
                    if (carInput) carInput.value = data.carrera || 'Computación e Informática';
                    if (cicInput) cicInput.value = data.cicloTurno || 'IV Ciclo / Turno Noche';
                } else {
                    if (statusSpan) {
                        statusSpan.style.color = '#f87171';
                        statusSpan.innerHTML = '<i class="ph-bold ph-x-circle"></i> ' + (data.message || 'No encontrado');
                    }
                }
            })
            .catch(err => {
                if (statusSpan) {
                    statusSpan.style.color = '#f87171';
                    statusSpan.textContent = 'Error al consultar DNI';
                }
            });
    }

    function guardarAtencionPsicologica() {
        const form = document.getElementById('formPsicologia');
        const formData = new FormData(form);
        const resultadoDiv = document.getElementById('resultadoAtencion');

        fetch('/Modulo05/Psicologia/GuardarAtencion', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (resultadoDiv) {
                    resultadoDiv.style.color = '#10b981';
                    resultadoDiv.innerHTML = '<i class="ph-bold ph-check-circle"></i> ' + data.message;
                }
                alert(data.message || 'Atención registrada con éxito');
                form.reset();
                const now = new Date();
                const tzOffset = now.getTimezoneOffset() * 60000;
                document.getElementById('fechaHora').value = (new Date(now - tzOffset)).toISOString().slice(0, 16);
                limpiarFormulario();
            } else {
                if (resultadoDiv) {
                    resultadoDiv.style.color = '#f87171';
                    resultadoDiv.innerHTML = '<i class="ph-bold ph-warning"></i> ' + data.message;
                }
                alert('Error: ' + data.message);
            }
        })
        .catch(err => {
            if (resultadoDiv) {
                resultadoDiv.style.color = '#f87171';
                resultadoDiv.textContent = 'Error de conexión: ' + err.message;
            }
        });
    }

    function limpiarFormulario() {
        const statusSpan = document.getElementById('dniStatus');
        const resultadoDiv = document.getElementById('resultadoAtencion');
        if (statusSpan) statusSpan.innerHTML = '';
        if (resultadoDiv) resultadoDiv.innerHTML = '';
    }

    function mostrarAtencionPsicologia() {
        document.querySelectorAll('.sidebar-nav .nav-item').forEach(el => el.classList.remove('active'));
        const target = document.getElementById('nav-atencion');
        if (target) target.classList.add('active');

        document.getElementById('view-historial').style.display = 'none';
        document.getElementById('view-atencion').style.display = 'block';
    }

    function mostrarHistorialPsicologia() {
        document.querySelectorAll('.sidebar-nav .nav-item').forEach(el => el.classList.remove('active'));
        const target = document.getElementById('nav-historial');
        if (target) target.classList.add('active');

        document.getElementById('view-atencion').style.display = 'none';
        document.getElementById('view-historial').style.display = 'block';
    }

    function cargarHistorialPsicologia() {
        const dniInput = document.getElementById('dniHistorial');
        const statusSpan = document.getElementById('historialStatus');
        const resultDiv = document.getElementById('historialResultados');
        const tableBody = document.getElementById('historialTableBody');
        const dni = dniInput ? dniInput.value.trim() : '';

        if (!dni) {
            alert('Ingrese el DNI para buscar su historial.');
            return;
        }

        if (statusSpan) {
            statusSpan.style.color = 'var(--text-muted)';
            statusSpan.innerHTML = '<i class="ph ph-spinner ph-spin"></i> Buscando...';
        }
        resultDiv.style.display = 'none';

        fetch('/Modulo05/Psicologia/Historial?dni=' + encodeURIComponent(dni))
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.data && data.data.length > 0) {
                        if (statusSpan) {
                            statusSpan.style.color = '#10b981';
                            statusSpan.innerHTML = '<i class="ph-bold ph-check-circle"></i> ' + data.data.length + ' registro(s) encontrado(s)';
                        }
                        tableBody.innerHTML = '';
                        data.data.forEach(item => {
                            const tr = document.createElement('tr');
                            tr.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
                            
                            tr.innerHTML = `
                                <td style="padding: 12px 10px;">${item.fechaHora}</td>
                                <td style="padding: 12px 10px; font-weight: 500;">${item.motivo}</td>
                                <td style="padding: 12px 10px;">
                                    <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 2px 8px; border-radius: 4px;">${item.estado || 'N/A'}</span>
                                </td>
                                <td style="padding: 12px 10px; color: var(--text-muted); max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${item.notas}">${item.notas || '-'}</td>
                            `;
                            tableBody.appendChild(tr);
                        });
                        resultDiv.style.display = 'block';
                    } else {
                        if (statusSpan) {
                            statusSpan.style.color = '#f59e0b';
                            statusSpan.innerHTML = '<i class="ph-bold ph-info"></i> No se encontraron sesiones previas';
                        }
                    }
                } else {
                    if (statusSpan) {
                        statusSpan.style.color = '#ef4444';
                        statusSpan.innerHTML = '<i class="ph-bold ph-warning"></i> ' + data.message;
                    }
                }
            })
            .catch(err => {
                if (statusSpan) {
                    statusSpan.style.color = '#ef4444';
                    statusSpan.innerHTML = '<i class="ph-bold ph-warning"></i> Error de conexión';
                }
            });
    }
</script>
