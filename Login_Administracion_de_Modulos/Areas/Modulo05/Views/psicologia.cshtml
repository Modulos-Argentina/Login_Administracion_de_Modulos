@{
    // Si la petición NO es parcial, usar el layout del dashboard
    if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest" && Context.Request.Query["partial"] != "true")
    {
        Layout = "~/Vista/Shared/_DashboardLayout.cshtml";
    }
    ViewData["Title"] = "Psicología";
    ViewData["Role"] = "Bienestar Estudiantil";
}

@section SidebarNav {
    <a href="/Dashboard/Psicologia" class="nav-item active">
        <i class="ph ph-brain"></i>
        Atención Psicológica
    </a>
    <a href="#" class="nav-item">
        <i class="ph ph-users"></i>
        Citas Programadas
    </a>
    <a href="#" class="nav-item">
        <i class="ph ph-file-text"></i>
        Historial Clínico
    </a>
}

<div class="page-header" style="margin-bottom: 1.5rem;">
    <h1>Módulo 05: Psicología</h1>
    <p>Formulario de Atención y Consulta Psicológica</p>
    <div class="header-accent"></div>
</div>

<form method="post" action="">

    <!-- I. IDENTIFICACIÓN DEL ESTUDIANTE -->
    <fieldset style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #4b5563; border-radius: 6px;">
        <legend style="padding: 0 0.5rem; font-weight: bold; color: #00f2fe;">I. IDENTIFICACIÓN DEL ESTUDIANTE</legend>

        <div style="margin-bottom: 1rem;">
            <label for="dniBusqueda" style="font-weight: 600;">BUSCAR ALUMNO (DNI):</label>
            <input type="text" id="dniBusqueda" name="dniBusqueda" placeholder="DNI..." maxlength="8" style="padding: 6px 10px;" />
            <button type="button" id="btnBuscarAlumno" style="padding: 6px 14px; cursor: pointer;">🔍 Buscar</button>
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="apellidosNombres" style="display: block; margin-bottom: 4px; font-weight: 600;">APELLIDOS Y NOMBRES</label>
            <input type="text" id="apellidosNombres" name="apellidosNombres" placeholder="- - -" readonly style="width: 100%; max-width: 450px; padding: 6px 10px;" />
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="carreraPrograma" style="display: block; margin-bottom: 4px; font-weight: 600;">CARRERA / PROGRAMA</label>
            <input type="text" id="carreraPrograma" name="carreraPrograma" placeholder="- - -" readonly style="width: 100%; max-width: 450px; padding: 6px 10px;" />
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="cicloTurno" style="display: block; margin-bottom: 4px; font-weight: 600;">CICLO / TURNO</label>
            <input type="text" id="cicloTurno" name="cicloTurno" placeholder="- - -" readonly style="width: 100%; max-width: 300px; padding: 6px 10px;" />
        </div>
    </fieldset>

    <!-- II. CREACIÓN DE EXPEDIENTE / CONSULTA ACTUAL -->
    <fieldset style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #4b5563; border-radius: 6px;">
        <legend style="padding: 0 0.5rem; font-weight: bold; color: #00f2fe;">II. CREACIÓN DE EXPEDIENTE / CONSULTA ACTUAL</legend>

        <div style="margin-bottom: 1rem;">
            <label for="fechaHora" style="display: block; margin-bottom: 4px; font-weight: 600;">FECHA Y HORA</label>
            <input type="datetime-local" id="fechaHora" name="fechaHora" value="2026-09-26T19:30" style="padding: 6px 10px;" />
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="estadoClinico" style="display: block; margin-bottom: 4px; font-weight: 600;">ESTADO CLÍNICO *</label>
            <select id="estadoClinico" name="estadoClinico" required style="padding: 6px 10px; width: 100%; max-width: 450px;">
                <option value="Pendiente — Evaluación Inicial" selected>Pendiente — Evaluación Inicial</option>
                <option value="En Proceso — En Terapia / Seguimiento">En Proceso — En Terapia / Seguimiento</option>
                <option value="Derivado — Especialista Externo">Derivado — Especialista Externo</option>
                <option value="Alta — Tratamiento Concluido">Alta — Tratamiento Concluido</option>
                <option value="Cancelado / Inasistencia">Cancelado / Inasistencia</option>
            </select>
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="motivoConsulta" style="display: block; margin-bottom: 4px; font-weight: 600;">MOTIVO DE CONSULTA Y CONTEXTO ACADÉMICO / FAMILIAR</label>
            <textarea id="motivoConsulta" name="motivoConsulta" rows="4" placeholder="Síntomas referidos o razones de bajo rendimiento..." style="width: 100%; max-width: 600px; padding: 8px;"></textarea>
        </div>
    </fieldset>

    <!-- DIAGNÓSTICO PRELIMINAR Y NOTAS CONFIDENCIALES DE TERAPIA -->
    <fieldset style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #4b5563; border-radius: 6px;">
        <legend style="padding: 0 0.5rem; font-weight: bold; color: #00f2fe;">DIAGNÓSTICO PRELIMINAR Y NOTAS CONFIDENCIALES DE TERAPIA</legend>

        <div>
            <p style="color: #f87171; font-weight: 500;">⚠️ NOTAS BAJO SECRETO PROFESIONAL</p>
            <label for="diagnosticoNotas" style="display: block; margin-bottom: 4px; font-weight: 600;">Notas de Terapia:</label>
            <textarea id="diagnosticoNotas" name="diagnosticoNotas" rows="6" placeholder="Evaluación HTP, Test Vocacional, Notas bajo secreto profesional..." style="width: 100%; max-width: 600px; padding: 8px;"></textarea>
        </div>
    </fieldset>

    <!-- Botones de Acción -->
    <div style="display: flex; gap: 12px; align-items: center;">
        <button type="reset" id="btnLimpiar" style="padding: 8px 18px; cursor: pointer;">Limpiar</button>
        <button type="submit" id="btnGuardar" style="padding: 8px 20px; cursor: pointer; font-weight: bold; background-color: #0284c7; color: #fff; border: 1px solid #0369a1; border-radius: 4px;">💾 Guardar Sesión</button>
    </div>

</form>
