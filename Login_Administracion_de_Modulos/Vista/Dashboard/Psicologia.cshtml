@{
    Layout = "~/Vista/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Panel de Psicología y Bienestar";
    ViewData["Role"] = "Bienestar Estudiantil";
}

@section SidebarNav {
    <a href="javascript:void(0)" class="nav-item active" id="nav-psy-dashboard" onclick="mostrarDashboardPsico()">
        <i class="ph ph-squares-four"></i>
        <span>Dashboard / Bienestar</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-psy-sesion" onclick="cargarSesionPsico()">
        <i class="ph ph-plus-circle"></i>
        <span>Nueva Sesión (M05)</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-psy-expediente" onclick="cargarExpedientePsico()">
        <i class="ph ph-folder-user"></i>
        <span>Expediente Alumno (M05)</span>
    </a>
}

<!-- Contenedor Principal Dinámico (SPA) -->
<div id="dynamic-main-content">

    <!-- 1. VISTA DASHBOARD / RESUMEN -->
    <div id="view-psy-dashboard">
        <div class="page-header" style="margin-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h1 style="font-size: 2rem; font-weight: 800; background: linear-gradient(90deg, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0 0 0.5rem 0;">
                        Módulo de Psicología y Bienestar Estudiantil
                    </h1>
                    <p style="color: var(--text-secondary); margin: 0;">Orientación psicológica, seguimiento confidencial y apoyo emocional a los estudiantes</p>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <button type="button" onclick="cargarSesionPsico()" class="btn btn-primary" style="background: linear-gradient(135deg, #6366f1, #a855f7); border: none; color: white; padding: 0.75rem 1.25rem; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35); cursor: pointer;">
                        <i class="ph-bold ph-plus"></i> Registrar Sesión
                    </button>
                    <button type="button" onclick="cargarExpedientePsico()" class="btn" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #fff; padding: 0.75rem 1.25rem; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <i class="ph-bold ph-lock-key"></i> Ver Expediente
                    </button>
                </div>
            </div>
            <div class="header-accent" style="margin-top: 1rem;"></div>
        </div>

        <!-- Tarjetas de Métricas de Psicología -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
            <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
                <div style="width: 52px; height: 52px; border-radius: 12px; background: rgba(99, 102, 241, 0.15); color: #6366f1; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
                    <i class="ph-fill ph-brain"></i>
                </div>
                <div>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; margin: 0;">Sesiones del Mes</p>
                    <h3 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">28</h3>
                </div>
            </div>

            <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
                <div style="width: 52px; height: 52px; border-radius: 12px; background: rgba(168, 85, 247, 0.15); color: #a855f7; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
                    <i class="ph-fill ph-users"></i>
                </div>
                <div>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; margin: 0;">Casos en Seguimiento</p>
                    <h3 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">14 Alumnos</h3>
                </div>
            </div>

            <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
                <div style="width: 52px; height: 52px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
                    <i class="ph-fill ph-check-circle"></i>
                </div>
                <div>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; margin: 0;">Cierres Exitosos</p>
                    <h3 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">9 Casos</h3>
                </div>
            </div>

            <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">
                <div style="width: 52px; height: 52px; border-radius: 12px; background: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
                    <i class="ph-fill ph-calendar-star"></i>
                </div>
                <div>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; margin: 0;">Citas para Hoy</p>
                    <h3 style="font-size: 1.8rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">4 Programadas</h3>
                </div>
            </div>
        </div>

        <!-- Agenda y Actividad Reciente -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
            <!-- Agenda del Día -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.75rem;">
                <h3 style="font-size: 1.2rem; font-weight: 700; color: #fff; margin: 0 0 1.25rem 0; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="ph ph-calendar" style="color: #6366f1;"></i> Agenda de Orientación Psicológica
                </h3>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: #a855f7; font-weight: 700; font-size: 0.85rem;">09:30 AM - Sesión de Seguimiento</span>
                            <h4 style="color: #fff; margin: 0.2rem 0; font-size: 1rem;">Estudiante: Carlos Dávila Rojas</h4>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Desarrollo de Sistemas - Ciclo II</p>
                        </div>
                        <span style="background: rgba(99,102,241,0.2); color: #818cf8; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;">Confirmado</span>
                    </div>

                    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: #a855f7; font-weight: 700; font-size: 0.85rem;">11:15 AM - Primera Consulta</span>
                            <h4 style="color: #fff; margin: 0.2rem 0; font-size: 1rem;">Estudiante: Mariana Gómez Quispe</h4>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Contabilidad - Ciclo IV</p>
                        </div>
                        <span style="background: rgba(16,185,129,0.2); color: #34d399; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;">En Espera</span>
                    </div>

                    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span style="color: #a855f7; font-weight: 700; font-size: 0.85rem;">03:00 PM - Orientación Vocacional</span>
                            <h4 style="color: #fff; margin: 0.2rem 0; font-size: 1rem;">Estudiante: Roberto Sánchez Ruiz</h4>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Administración de Redes - Ciclo I</p>
                        </div>
                        <span style="background: rgba(245,158,11,0.2); color: #fbbf24; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;">Pendiente</span>
                    </div>
                </div>
            </div>

            <!-- Acciones Rápidas y Protocolos Confidenciales -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <h3 style="font-size: 1.2rem; font-weight: 700; color: #fff; margin: 0 0 1rem 0; display: flex; align-items: center; gap: 0.5rem;">
                        <i class="ph ph-shield-check" style="color: #10b981;"></i> Protocolo de Confidencialidad
                    </h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.25rem;">
                        Las notas clínicas, observaciones de conducta y diagnósticos registrados en este submódulo están bajo secreto profesional conforme a la Ley de Salud Mental y normativas del MINEDU. Los accesos quedan auditados en PostgreSQL.
                    </p>
                    <div style="background: rgba(99,102,241,0.1); border-left: 4px solid #6366f1; padding: 1rem; border-radius: 0 8px 8px 0; margin-bottom: 1.5rem;">
                        <strong style="color: #c7d2fe; display: block; margin-bottom: 0.3rem;">Recordatorio Ético:</strong>
                        <span style="color: #94a3b8; font-size: 0.85rem;">Garantizar un ambiente seguro, empático y libre de prejuicios durante cada sesión terapéutica.</span>
                    </div>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <button type="button" onclick="cargarSesionPsico()" style="flex: 1; text-align: center; background: linear-gradient(135deg, #6366f1, #a855f7); color: #fff; padding: 0.85rem; border-radius: 10px; font-weight: 700; border: none; cursor: pointer;">
                        Nueva Sesión
                    </button>
                    <button type="button" onclick="cargarExpedientePsico()" style="flex: 1; text-align: center; background: rgba(255,255,255,0.08); color: #fff; padding: 0.85rem; border-radius: 10px; font-weight: 700; border: 1px solid rgba(255,255,255,0.15); cursor: pointer;">
                        Buscar Expediente
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. CONTENEDOR DINÁMICO DE FORMULARIO DE SESIÓN (Modulo 05) -->
    <div id="view-sesion-container" style="display: none;"></div>

    <!-- 3. CONTENEDOR DINÁMICO DE EXPEDIENTE DEL ALUMNO (Modulo 05) -->
    <div id="view-expediente-container" style="display: none;"></div>

</div>

@section Scripts {
    <script>
        function setActiveNavPsico(elementId) {
            document.querySelectorAll('.sidebar-nav .nav-item').forEach(el => el.classList.remove('active'));
            const target = document.getElementById(elementId);
            if (target) target.classList.add('active');
        }

        function mostrarDashboardPsico() {
            setActiveNavPsico('nav-psy-dashboard');
            document.getElementById('view-sesion-container').style.display = 'none';
            document.getElementById('view-expediente-container').style.display = 'none';
            document.getElementById('view-psy-dashboard').style.display = 'block';
        }

        function cargarSesionPsico() {
            setActiveNavPsico('nav-psy-sesion');
            document.getElementById('view-psy-dashboard').style.display = 'none';
            document.getElementById('view-expediente-container').style.display = 'none';
            const container = document.getElementById('view-sesion-container');
            container.style.display = 'block';

            if (!container.dataset.loaded) {
                container.innerHTML = `
                    <div style="padding: 3rem; text-align: center; color: var(--text-secondary);">
                        <i class="ph ph-spinner ph-spin" style="font-size: 2.5rem; color: #a855f7; margin-bottom: 1rem; display: block;"></i>
                        <p>Cargando formulario de sesión psicológica de Módulo 05...</p>
                    </div>
                `;

                fetch('/Modulo05/Psicologia/FormSesion?partial=true', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => {
                    if (!res.ok) throw new Error('Error de respuesta HTTP: ' + res.status);
                    return res.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    container.dataset.loaded = "true";

                    // Reejecutar scripts dentro de la vista parcial
                    const scripts = container.querySelectorAll('script');
                    scripts.forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                })
                .catch(err => {
                    container.innerHTML = `
                        <div style="padding: 2rem; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; border-radius: 8px; color: #fca5a5;">
                            <h4>Error al cargar el formulario de sesión</h4>
                            <p>${err.message}</p>
                            <button type="button" onclick="cargarSesionPsico()" style="margin-top: 10px; padding: 6px 12px; cursor: pointer;">Reintentar</button>
                        </div>
                    `;
                });
            }
        }

        function cargarExpedientePsico() {
            setActiveNavPsico('nav-psy-expediente');
            document.getElementById('view-psy-dashboard').style.display = 'none';
            document.getElementById('view-sesion-container').style.display = 'none';
            const container = document.getElementById('view-expediente-container');
            container.style.display = 'block';

            if (!container.dataset.loaded) {
                container.innerHTML = `
                    <div style="padding: 3rem; text-align: center; color: var(--text-secondary);">
                        <i class="ph ph-spinner ph-spin" style="font-size: 2.5rem; color: #a855f7; margin-bottom: 1rem; display: block;"></i>
                        <p>Cargando consulta de expedientes de Módulo 05...</p>
                    </div>
                `;

                fetch('/Modulo05/Psicologia/ExpedienteAlumno?partial=true', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => {
                    if (!res.ok) throw new Error('Error de respuesta HTTP: ' + res.status);
                    return res.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    container.dataset.loaded = "true";

                    const scripts = container.querySelectorAll('script');
                    scripts.forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                })
                .catch(err => {
                    container.innerHTML = `
                        <div style="padding: 2rem; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; border-radius: 8px; color: #fca5a5;">
                            <h4>Error al cargar el expediente del alumno</h4>
                            <p>${err.message}</p>
                            <button type="button" onclick="cargarExpedientePsico()" style="margin-top: 10px; padding: 6px 12px; cursor: pointer;">Reintentar</button>
                        </div>
                    `;
                });
            }
        }
    </script>
}
