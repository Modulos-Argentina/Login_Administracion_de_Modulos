@{
    Layout = "~/Vista/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Tesorería - Trámites y Matrícula";
    ViewData["Role"] = "Tesorería";
}

@section SidebarNav {
    <!-- Encabezado Institucional: Trámites y Matrícula -->
    <div class="sidebar-brand-tesoreria">
        <div class="brand-icon-wrap">
            <i class="ph-fill ph-shield-check"></i>
        </div>
        <div class="brand-details">
            <h5>IESTP "Argentina"</h5>
            <p>Trámites y Matrícula</p>
        </div>
    </div>

    <!-- Lista de Botones del Panel Lateral (según captura exacta) -->
    <div style="display: flex; flex-direction: column; gap: 0.15rem;">
        <a href="javascript:void(0)" class="nav-item-tesoreria active" id="nav-tes-inicio" onclick="mostrarSeccionTesoreria('seccion-tes-inicio', this)">
            <i class="ph ph-house nav-icon"></i>
            <span class="nav-text">Inicio</span>
        </a>

        <a href="javascript:void(0)" class="nav-item-tesoreria" id="nav-tes-vouchers" onclick="mostrarSeccionTesoreria('seccion-tes-vouchers', this)">
            <i class="ph ph-credit-card nav-icon"></i>
            <span class="nav-text">Bandeja de vouchers</span>
            <span class="tesoreria-badge-pill" id="badge-vouchers-count">1</span>
        </a>

        <a href="javascript:void(0)" class="nav-item-tesoreria" id="nav-tes-recibos" onclick="mostrarSeccionTesoreria('seccion-tes-recibos', this)">
            <i class="ph ph-receipt nav-icon"></i>
            <span class="nav-text">Recibos</span>
        </a>

        <a href="javascript:void(0)" class="nav-item-tesoreria" id="nav-tes-matriculas" onclick="mostrarSeccionTesoreria('seccion-tes-matriculas', this)">
            <i class="ph ph-clipboard-text nav-icon"></i>
            <span class="nav-text">Matrículas</span>
        </a>

        <a href="javascript:void(0)" class="nav-item-tesoreria" id="nav-tes-estudiantes" onclick="mostrarSeccionTesoreria('seccion-tes-estudiantes', this)">
            <i class="ph ph-user nav-icon"></i>
