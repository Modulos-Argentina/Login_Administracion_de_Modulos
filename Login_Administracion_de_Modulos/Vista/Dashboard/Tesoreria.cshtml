        </a>

        <a href="javascript:void(0)" class="nav-item-tesoreria" id="nav-tes-buzon" onclick="mostrarSeccionTesoreria('seccion-tes-buzon', this)">
            <i class="ph ph-chat-teardrop-text nav-icon"></i>
            <span class="nav-text">Buzón</span>
        </a>

        <a href="javascript:void(0)" class="nav-item-tesoreria" id="nav-tes-whatsapp" onclick="mostrarSeccionTesoreria('seccion-tes-whatsapp', this)">
