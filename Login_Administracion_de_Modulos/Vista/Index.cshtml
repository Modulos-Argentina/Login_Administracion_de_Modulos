@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Administración de Módulos</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
</head>
<body>
    <div class="login-container">
        <!-- Left Side -->
        <div class="left-side">
            <div class="left-content">
                <div class="badge-secure">
                    <i class="ph-fill ph-shield-check"></i>
                    Plataforma Segura
                </div>
                <h1>Tu carrera<br/>tecnológica<br/><span>empieza hoy.</span></h1>
                <p>Accede al campus virtual y domina las habilidades que el mercado laboral exige.</p>
            </div>
            <div class="stats">
                <div class="stat-item">
                    <h3>4</h3>
                    <p>Módulos Activos</p>
                </div>
                <div class="stat-item">
                    <h3>100%</h3>
                    <p>Digital</p>
                </div>
                <div class="stat-item">
                    <h3>24/7</h3>
                    <p>Disponible</p>
                </div>
            </div>
        </div>

        <!-- Right Side -->
        <div class="right-side">
            <div class="login-header">
                <h2>¡Hola de nuevo!</h2>
                <p>Inicia sesión para acceder a la plataforma institucional.</p>
            </div>

            <button class="btn-google">
                <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" width="18" height="18" />
                Continuar con Google
            </button>

            <div class="divider">
                <span>O INICIA SESIÓN CON TU USUARIO</span>
            </div>

            @if (ViewBag.Error != null)
            {
                <div style="color: #d9534f; background-color: #f9f2f2; border: 1px solid #d9534f; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                    @ViewBag.Error
                </div>
            }

            <form action="/Login/Index" method="POST">
                <div class="form-group">
                    <label>Usuario Institucional</label>
                    <div class="input-wrapper">
                        <i class="ph ph-user"></i>
                        <input type="email" name="correo" class="form-control" placeholder="ej. usuario@institucion.edu" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <div class="input-wrapper">
                        <i class="ph ph-lock"></i>
                        <input type="password" name="clave" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="form-options">
                    <label class="checkbox-wrapper">
                        <input type="checkbox" />
                        <span>Recordarme</span>
                    </label>
                    <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="ph ph-sign-in"></i>
                    Ingresar al Campus
                </button>
            </form>

            <div class="modules-section">
                <h3>Acceso Rápido - Demo</h3>
                <div class="module-list">
                    <a href="/Dashboard/Topico" class="module-card">
                        <div class="module-icon icon-enfermeria">
                            <i class="ph ph-first-aid"></i>
                        </div>
                        <div class="module-info">
                            <h4>Enfermería</h4>
                            <p>Módulo de Tópico</p>
                        </div>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>
                    
                    <a href="/Dashboard/Psicologia" class="module-card">
                        <div class="module-icon icon-psicologia">
                            <i class="ph ph-brain"></i>
                        </div>
                        <div class="module-info">
                            <h4>Psicología</h4>
                            <p>Bienestar Estudiantil</p>
                        </div>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>

                    <a href="/Dashboard/Docente" class="module-card">
                        <div class="module-icon icon-docente">
                            <i class="ph ph-chalkboard-teacher"></i>
                        </div>
                        <div class="module-info">
                            <h4>Docente</h4>
                            <p>Portal Docente</p>
                        </div>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>

                    <a href="/Dashboard/Soporte" class="module-card">
                        <div class="module-icon icon-soporte">
                            <i class="ph ph-wrench"></i>
                        </div>
                        <div class="module-info">
                            <h4>Admin. Soporte</h4>
                            <p>Gestión de Incidencias</p>
                        </div>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
