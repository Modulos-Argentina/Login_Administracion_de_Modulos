@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Intranet Institucional - IESTP Argentina</title>
    <!-- Script inmediato de tema (evita parpadeo) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('app-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <link rel="stylesheet" href="~/css/login.css" />
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
</head>
<body>
    <div class="login-container">
        <!-- Left Side -->
        <div class="left-side">
            <div class="left-content">
                <div class="badge-secure">
                    <i class="ph-fill ph-shield-check"></i>
                    Intranet Institucional
                </div>
                <h1>Tu carrera<br/>tecnológica<br/><span>empieza hoy.</span></h1>
                <p>Accede a la Intranet Institucional y gestiona tus servicios académicos y administrativos.</p>
            </div>
            <div class="stats">
                <div class="stat-item">
                    <h3>4</h3>
                    <p>Módulos Activos</p>
                </div>
                <div class="stat-item">
                    <h3>100%</h3>
                    <p>Digital</p>
                </div>
                <div class="stat-item">
                    <h3>24/7</h3>
                    <p>Disponible</p>
                </div>
            </div>
        </div>

        <!-- Right Side -->
        <div class="right-side">
            <!-- Barra superior con selector de tema -->
            <div class="login-top-bar">
                <button type="button" id="loginThemeToggleBtn" class="theme-toggle-btn" onclick="toggleTheme()" aria-label="Cambiar tema">
                    <i class="ph ph-sun theme-icon-light"></i>
                    <i class="ph ph-moon theme-icon-dark"></i>
                    <span class="theme-toggle-text">Modo Claro</span>
                </button>
            </div>

            <div class="login-header">
                <div class="logo-container">
                    <img src="~/images/Logoanimado.webp" alt="Logo Instituto Argentina" class="institute-logo" />
                </div>
                <div class="intranet-badge">
                    <i class="ph-fill ph-buildings"></i>
                    Intranet Institucional
                </div>
                <h2>¡Hola de nuevo!</h2>
                <p>Inicia sesión para acceder a la Intranet Institucional.</p>
            </div>

            <a href="/login-google-oauth" class="btn-google" style="display: flex; justify-content: center; align-items: center; text-decoration: none; gap: 8px;">
                <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" width="18" height="18" />
                Continuar con Google Institucional
            </a>

            <div class="divider">
                <span>O INICIA SESIÓN CON TU USUARIO</span>
            </div>

            @if (ViewBag.Error != null)
            {
                <div style="color: #d9534f; background-color: #f9f2f2; border: 1px solid #d9534f; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                    @ViewBag.Error
                </div>
            }

            <form action="/login-dni" method="POST">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>DNI del Alumno</label>
                    <div class="input-wrapper">
                        <i class="ph ph-identification-card"></i>
                        <input type="text" name="dni" class="form-control" placeholder="ej. 74296138" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <div class="input-wrapper">
                        <i class="ph ph-lock"></i>
                        <input type="password" id="passwordInput" name="clave" class="form-control" placeholder="••••••••" required />
                        <button type="button" class="btn-toggle-password" onclick="togglePassword()">
                            <i class="ph ph-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="checkbox-wrapper">
                        <input type="checkbox" />
                        <span>Recordarme</span>
                    </label>
                    <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="ph ph-sign-in"></i>
                    Ingresar a la Intranet
                </button>
            </form>

            <div class="modules-section">
                <div class="modules-header-bar">
                    <h3>Acceso Rápido - Modo Demo Local</h3>
                    <span class="demo-tag" style="margin: 0;">Sin BD</span>
                </div>
                <p class="modules-subtitle">Ingresa a los paneles con una sesión local de prueba sin necesidad de usuario ni contraseña:</p>
                <div class="module-list">
                    <a href="/login-demo/topico" class="module-card">
                        <div class="module-icon icon-enfermeria">
                            <i class="ph ph-first-aid"></i>
                        </div>
                        <div class="module-info">
                            <h4>Enfermería (Tópico)</h4>
                            <p>Módulo de Salud y Triaje</p>
                        </div>
                        <span class="demo-tag">Probar</span>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>
                    
                    <a href="/login-demo/psicologia" class="module-card">
                        <div class="module-icon icon-psicologia">
                            <i class="ph ph-brain"></i>
                        </div>
                        <div class="module-info">
                            <h4>Psicología</h4>
                            <p>Bienestar Estudiantil y Casos</p>
                        </div>
                        <span class="demo-tag">Probar</span>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>

                    <a href="/login-demo/docente" class="module-card">
                        <div class="module-icon icon-docente">
                            <i class="ph ph-chalkboard-teacher"></i>
                        </div>
                        <div class="module-info">
                            <h4>Docente</h4>
                            <p>Portal Docente y Reporte de Averías</p>
                        </div>
                        <span class="demo-tag">Probar</span>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>

                    <a href="/login-demo/soporte" class="module-card">
                        <div class="module-icon icon-soporte">
                            <i class="ph ph-wrench"></i>
                        </div>
                        <div class="module-info">
                            <h4>Admin. Soporte</h4>
                            <p>Consola Técnica e Incidencias</p>
                        </div>
                        <span class="demo-tag">Probar</span>
                        <i class="ph ph-caret-right module-arrow"></i>
                    </a>
                </div>

                <!-- Paneles adicionales de prueba -->
                <div class="secondary-modules-wrapper">
                    <p class="secondary-modules-title">Otros Paneles (Demo):</p>
                    <div class="secondary-modules-grid">
                        <a href="/login-demo/alumno" class="module-card module-card-sm">
                            <div class="module-icon icon-alumno">
                                <i class="ph ph-student"></i>
                            </div>
                            <div class="module-info">
                                <h4>Alumno</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/secretaria" class="module-card module-card-sm">
                            <div class="module-icon icon-secretaria">
                                <i class="ph ph-files"></i>
                            </div>
                            <div class="module-info">
                                <h4>Secretaría</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/practicante" class="module-card module-card-sm">
                            <div class="module-icon icon-practicante">
                                <i class="ph ph-briefcase"></i>
                            </div>
                            <div class="module-info">
                                <h4>Practicante</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <!-- Botón Tesorería ubicado debajo de Secretaría -->
                        <a href="/login-demo/tesoreria" class="module-card module-card-sm">
                            <div class="module-icon icon-tesoreria">
                                <i class="ph ph-bank"></i>
                            </div>
                            <div class="module-info">
                                <h4>Tesorería</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/admin" class="module-card module-card-sm">
                            <div class="module-icon icon-admin">
                                <i class="ph ph-shield-star"></i>
                            </div>
                            <div class="module-info">
                                <h4>Administrador</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/jefe" class="module-card module-card-sm card-jefe">
                            <div class="module-icon icon-jefe">
                                <i class="ph ph-crown"></i>
                            </div>
                            <div class="module-info">
                                <h4>Jefe General</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/computacion" class="module-card module-card-sm card-computacion">
                            <div class="module-icon icon-computacion">
                                <i class="ph ph-desktop"></i>
                            </div>
                            <div class="module-info">
                                <h4>Jefe Computación</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/taller-administracion" class="module-card module-card-sm card-administracion">
                            <div class="module-icon icon-administracion">
                                <i class="ph ph-chart-bar"></i>
                            </div>
                            <div class="module-info">
                                <h4>Jefe Administración</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/taller-contabilidad" class="module-card module-card-sm card-contabilidad">
                            <div class="module-icon icon-contabilidad">
                                <i class="ph ph-calculator"></i>
                            </div>
                            <div class="module-info">
                                <h4>Jefe Contabilidad</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                        <a href="/login-demo/inventario" class="module-card module-card-sm card-inventario">
                            <div class="module-icon icon-inventario">
                                <i class="ph ph-package"></i>
                            </div>
                            <div class="module-info">
                                <h4>Encargado Inventario</h4>
                            </div>
                            <i class="ph ph-caret-right module-arrow"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('ph-eye');
                toggleIcon.classList.add('ph-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('ph-eye-slash');
                toggleIcon.classList.add('ph-eye');
            }
        }
    </script>
</body>
</html>
